; Copy to wawbf.ini next to d3d9.dll in Star Wars Battlefront II Classic\GameData
; (the folder with BattlefrontII.exe). Comments start with ';'.

[bridge]
tick_hz = 60

[swbf2]
; Where BattlefrontII.exe keeps the player unit's position (3 floats).
; Formats: BattlefrontII.exe+0x123456 | 0x00ABCDEF | BattlefrontII.exe+0x1234 > 0x10 > 0x2C
; Found for the Steam exe listed in docs/PHASE0.md (step 4). It is the unit
; the camera follows, which is the player's while they are alive.
player_position = BattlefrontII.exe+0x1A296B0 > 0x0
; How to tell that player_position really is a unit's position right now.
; A soldier object starts with the address of its class (unit_type), and its
; position is unit_position_offset bytes in. Nothing is ever written unless
; this matches, because while the player is dead player_position points at
; something else, and overwriting that crashes the game.
unit_type = BattlefrontII.exe+0x39D114
unit_position_offset = 0x120
; Where the unit's velocity is (3 floats, metres per second, same formats).
; Optional. When set, it is replaced every frame along the axes being
; followed, so speed the game still thinks the unit has cannot build up:
; with zero, or with the WaW player's own speed if follow_velocity = 1.
player_velocity = BattlefrontII.exe+0x1A296B0 > 0x3BC
; How far up or down the unit aims: one float, radians, positive looking up.
; The game works the aim direction and the camera out from it.
aim_pitch = BattlefrontII.exe+0x1A296B0 > 0x3C8
; 1 = move the BF unit to wherever the WaW player is.
follow = 0
; 1 = give the unit the WaW player's speed instead of none, so the game has
; something to choose its animation from. Needs player_velocity.
follow_velocity = 0
; 1 = aim up and down with the WaW player. Needs aim_pitch.
follow_pitch = 0
; 0 = follow on the ground plane only and leave the unit's height to SWBF2,
; so it stands on SWBF2's ground. 1 = take height from WaW as well.
follow_height = 0
; 1 = turn the unit to face where the WaW player is looking. The unit's
; transform is the 4x4 ending at player_position, and its direction rows are
; rewritten every frame. The log says how often the game kept them.
follow_facing = 0
; How far behind "now" the WaW player is placed, in milliseconds. The two
; games draw at different rates; the unit is placed between the two newest
; WaW samples at this delay, which is what keeps it from stuttering. About
; one WaW frame is right. 0 = always run ahead of the newest sample.
follow_delay_ms = 12
; Optional: other places that hold a copy of the unit's forward direction,
; as offsets from player_position, written too. Candidates from the recording
; in docs: 0x208, 0x428.
facing_extra =
; 1 = keep a match playing when the game's window is not the focused one.
; Without it the match pauses as soon as you click another window. Needs
; windowed mode (/win). Can be switched live.
keep_running = 0
; 1 = do not show the game's window at all. It goes on drawing and playing.
; Can be switched live; leave it 0 while there are menus to click through.
hidden = 0
; 1 = this game is heard while another window is in front (it is otherwise
; silent the moment it is not the one with the keyboard, which under World at
; War is always). Only sounds the game makes after the bridge is loaded are
; changed, so it takes a restart.
sound_in_background = 1
; 1 = pull this game's trigger while the WaW player holds theirs. The game's
; "fire" is switched on inside the game itself, after it has read its own
; devices, so it does not matter what fire is bound to in this game's options
; (mouse, key or controller) or that its window is not the one in front. Can
; be switched live. See docs/PHASE2.md.
forward_fire = 0
; Which of the game's functions each WaW button works, by the game's own
; numbering: 0 = primary fire, 5 = zoom, 7 = reload (docs/PHASE2.md).
; -1 = that button is not passed on. WaW's buttons are its own attack, aim
; and reload, however the player has those bound there.
fire_function = 0
aim_function = 5
reload_function = 7
; Fire and reload are held on while WaW's are held. Zoom is not held in this
; game but pressed, once to go in and once to come out, so for aim the bridge
; presses it whenever the game is not zoomed the way WaW's aim is held. It
; tells by the field of view (view_projection below has to be set): under
; this many degrees top to bottom counts as zoomed in. 0 = do not look, and
; press once each time WaW's aim changes.
zoomed_below_fov = 40
; The game's view-projection matrix (4 rows of 4 floats), read only, to work
; out the field of view it is drawing with. The log says whether that matches
; WaW's whenever either changes.
view_projection = BattlefrontII.exe+0x3DE368
; Flips a setting between two values each time a key is pressed, whichever
; window has the keyboard. Meant for first / third person, which the game
; only offers in its pause menu. The address below is that setting in the
; Steam exe: 0 = third person, 1 = first person (docs/PHASE1.md says how it
; was found). Format: <address> = <u8|u32|f32> <one value> <the other value>
; view_toggle_key is a Windows virtual-key code: 0x78 = F9.
view_toggle = BattlefrontII.exe+0x1AF9106 = u8 0 1
view_toggle_key = 0x78
; The same from a controller: XInput's number for the button (0x0001 up on the
; d-pad, 0x0002 down, 0x0004 left, 0x0008 right). 0 = none.
view_toggle_pad = 0x0008
; The view is third person while this address holds this value. WaW is told,
; so that it draws from behind the player as well and leaves its own soldier
; out. Same address as view_toggle. Format: <address> = <u8|u32|f32> <value>
third_person = BattlefrontII.exe+0x1AF9106 = u8 0
; 1 = in third person, draw from exactly where WaW's camera is, so that the
; character stands where WaW's player does. Without it this game's own
; camera is used, which sits somewhere else and knows nothing of WaW's walls.
; See docs/PHASE2.md.
follow_camera = 0
; Changing character without the spawn screen, whichever window has the
; keyboard. The arena's mission script does the changing; the bridge asks it
; by writing a number where the script looks, which is the unit's health (the
; unit cannot be hurt, so nothing else uses it). next_hero is the next of
; team 1's characters, next_villain the next of team 2's; asking for the
; other team's goes to the one last used there. The numbers must be the ones
; in swbf2/arena/WAW_arena.lua. Same format as [debug] poke; the address is
; the unit's health, found as docs/PHASE2.md says. 0x79 = F10, 0x7A = F11.
next_hero = BattlefrontII.exe+0x1A296B0 > 0x24 = f32 9e36
next_hero_key = 0x79
next_villain = BattlefrontII.exe+0x1A296B0 > 0x24 = f32 8e36
next_villain_key = 0x7A
; And from a controller, as view_toggle_pad: up and down on the d-pad.
next_hero_pad = 0x0001
next_villain_pad = 0x0002
; Third person: how big the character is drawn, 1 being as this game makes it.
; Its soldiers stand well over the height of a WaW zombie. They cannot be
; made smaller, but the camera is put further from them: everything shrinks
; towards the character's feet, which stay where WaW's player stands.
; character_scale_kits gives particular kits their own (kit = scale, ...):
; 10 is Yoda, who is small enough already.
character_scale = 0.88
character_scale_kits = 10 = 1.0
; Which kit the character carries, for WaW to hand its player the weapons
; that match (docs/PHASE3.md). The arena's mission script knows the class and
; the bridge cannot ask it, so the script writes the answer into the unit's
; full health, which is what this address is: 1e37 * (1 + kit / 1024), with
; 32 added to the kit for a hero and 64 for one with a lightsaber. A hero is
; put in third person when the player becomes one, and one with a lightsaber
; is kept there.
unit_kit = BattlefrontII.exe+0x1A296B0 > 0x28
; The unit's weapons: eight pointers, and straight after them a byte each for
; which of the eight is in hand as the weapon and which as the ability (the
; game's "secondary": a grenade, a rocket, a Force power). Found with
; tools/probe/bfweapons.ps1. weapon_state_offset is where, in a weapon, a
; number sits that is 0 while the weapon is idle; the bridge counts a use of
; the ability each time the selected one's leaves 0, and WaW's scripts make
; the same thing happen to the zombies.
unit_weapons = BattlefrontII.exe+0x1A296B0 > 0x600
weapon_state_offset = 0xB0
; The functions behind the rest of what the WaW bridge sends (forward_fire
; has to be 1; -1 = not passed on):
;   ability_function        WaW's grenade button: "secondary fire", 1
;   melee_ability_function  the same for a character with a lightsaber. The
;                           game gives those their own buttons: its secondary
;                           fire raises the blade to block, and the Force is
;                           on what is reload for everyone else, 7. For them
;                           WaW's aim button works it too, and reload is not
;                           passed on.
;   next_ability_function   the WaW bridge's "next ability" key and button, 15
;   next_weapon_function    13. Nothing in WaW is bound to it: WaW's scripts
;                           say which weapon the player has in hand there, and
;                           the bridge presses this until the unit's agrees.
ability_function = 1
melee_ability_function = 7
next_ability_function = 15
next_weapon_function = 13
; The character does what WaW's player does (docs/PHASE3.md):
;   jump_function    3, pressed when WaW's jump is
;   crouch_function  4. It is a switch in this game, so it is pressed whenever
;                    the unit is not the way WaW's player is. unit_crouched
;                    says how the unit is: crouched while that byte has those
;                    bits set.
;   sprint_function  2, held while WaW's player sprints.
; The stick: the unit goes where the bridge puts it, but the game picks how
; the character moves its legs from its stick, and will not sprint without
; "forward". forward_axis and strafe_axis are which of the control state's
; floats those are (+1 is forwards, +1 is to the left); the stick is pushed
; the way WaW's player is really going, all the way at stick_full_at metres a
; second (WaW's run). -1 leaves the stick alone.
; unit_energy is what sprinting spends in this game; it is kept at
; unit_energy_full, because WaW decides how long the player can sprint.
jump_function = 3
crouch_function = 4
sprint_function = 2
unit_crouched = BattlefrontII.exe+0x1A296B0 > 0x622 = u8 64
forward_axis = 1
strafe_axis = 0
stick_full_at = 4.8
; A character with a lightsaber is not told to sprint when WaW's player does.
; The game paces a character's legs by the ground it really covers, and its
; sprint for those characters is a bounding run made for 22 metres a second:
; at the 7 WaW's player sprints at, a step took a whole second. Their
; ordinary run, made for 9, takes a stride every 0.8 s at that speed, so that
; is what they do instead. 1 = the game's own sprint for them as well.
saber_sprint = 0
unit_energy = BattlefrontII.exe+0x1A296B0 > 0x8F4
unit_energy_full = 100

[mapping]
; How WaW space maps onto BF space - see protocol/wawbf_protocol.h.
; anchor_waw (WaW units) lands on anchor_bf (BF units).
anchor_waw = 0, 0, 0
anchor_bf = 0, 0, 0
; BF units per WaW unit. 0.0254 assumes BF uses metres and WaW inches.
scale = 0.0254
; -1 is right; settled by eye, see docs/PHASE1.md. With 1 the unit turns left
; when the player turns right.
z_sign = -1
yaw_sign = 1
yaw_offset = 0
; WaW's pitch grows looking down, SWBF2's looking up.
pitch_sign = -1

[debug]
; Writes one value into the game, once, each time this line is changed.
; For trying out a newly found address without building a new DLL.
; Format: <address> = <u8|u32|f32> <value>
; e.g.    BattlefrontII.exe+0x123456 > 0x10 = u8 1
poke =
; hold1 .. hold8: the same, but written every frame for as long as the line
; is there, and only while the camera is on a live unit. The log says once a
; second whether the game left the value alone, and what it put there if not.
; e.g.    BattlefrontII.exe+0x1A296B0 > 0x3C8 = f32 0.5   (aim 29 degrees up)
hold1 =
hold2 =
; Hold WaW buttons down without WaW: 1 = fire, 2 = aim, 4 = reload,
; added together. Needs forward_fire = 1.
force_buttons = 0
; Hold game functions on directly, one bit each (0x1 = function 0, 0x2 =
; function 1, 0x4 = function 2 ...), for finding out which number does what.
; Needs forward_fire = 1.
force_functions = 0
; Pushes one of the game's four stick axes to a value, to find which is which:
;   force_axis = <axis 0-3> <value>
force_axis =
; treadmill = 4.8 : while WaW's player stands still the unit is told it is going
; forwards at this speed (metres a second), and runs on the spot. For looking
; at its legs with nobody playing. 0 or absent = off.
treadmill = 0
; log_sound = 1 : once a second, what each of the game's sound buffers is
; doing (playing or not, how loud the game has set it).
log_sound = 0
; 1 = hook the Direct3D device's drawing calls so a frame can be recorded
; (read at start-up; publishing a picture switches it on by itself).
frame_probe = 0
; Change this to record the next whole frame: how it was drawn goes to
; wawbf_frame_<label>.txt and pictures of it to wawbf_frame_<label>_*.bmp,
; next to the game. "<label>: 120, 240" also saves the picture before those
; draw calls. See docs/PHASE2.md.
frame_dump =
; For experiments only: make this depth-only clear of every frame clear the
; picture too, to this colour (alpha, red, green, blue). 0 = off.
frame_cut = 0
frame_cut_colour = 0x00000000
; For experiments only: 1 = do what [overlay] cut = 0 does to the frame (see
; below) without sending the picture anywhere.
transparent_clears = 0
; 1 = log where in the game each kind of Direct3D transform is set from, the
; first time each place is seen. Needs frame_probe or [overlay] publish.
transform_callers = 0

[overlay]
; 1 = send this game's picture to WaW every frame, to be drawn over WaW's.
; What is in the picture depends on cut:
;
; cut = 0  The whole frame, with its black background made see-through. For
;          the arena swbf2/arena builds, which draws nothing but the player:
;          their character in third person, their weapon in first, their
;          shots, and the HUD.
; cut = 2  Only what is drawn after the frame's second depth-only clear: the
;          first-person weapon and the HUD. For a world with a ground and a
;          sky (the arena built with -Ground, or any stock map). No third
;          person, and no shots: those are part of the world.
;
; See docs/PHASE2.md.
publish = 0
cut = 0
; Two things of this game's own that the whole picture (cut = 0) leaves out.
;
; hide_ground: the arena has to have one square of terrain (the game will not
; put the player into a world with none), and the game draws it wherever the
; player is: a line of grass on the horizon. It is a strip of triangles,
; always with this many corners and this many triangles; a draw call of
; exactly that shape is skipped. Leave it out to draw everything.
;
; hud_keep: of this game's HUD only what falls in this part of the picture is
; drawn (left, top, right, bottom, each 0 to 1 across or down it): the place
; of the weapons and abilities, as the arena's build raises them (its
; -HudLift has to agree with this). Everything else of the HUD, the game's
; own crosshair included, is not drawn; while the game is zoomed in, nothing
; of it is. hud_lens is how the HUD's part of the frame is known: the x scale
; of the projection the game draws it through (1.7321 at 16:9). Leave
; hud_keep out for the whole HUD.
hide_ground = 81, 149
hud_keep = 0, 0.57, 0.33, 0.745
hud_lens = 1.7321

[proxy]
chain =

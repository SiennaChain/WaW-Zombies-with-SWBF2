; Copy to wawbf.ini next to d3d9.dll in the Call of Duty World at War folder
; (the one with CoDWaW.exe). Comments start with ';'.

[bridge]
tick_hz = 60

[waw]
; Where CoDWaW.exe keeps the local player's position (3 floats, feet,
; WaW units) and view angles (3 floats: pitch, yaw, roll in degrees).
; Formats: CoDWaW.exe+0x123456 | 0x00ABCDEF | CoDWaW.exe+0x1234 > 0x10 > 0x2C
; Found for the Steam 1.7 exe listed in docs/PHASE0.md (step 4); a different
; exe build needs them found again.
player_origin = CoDWaW.exe+0x14ED088
view_angles = CoDWaW.exe+0x14ED18C
; The field of view WaW is drawing with: two floats, the tangents of half
; the horizontal and half the vertical angle (tools/probe/wawfov.ps1 finds
; it). Optional. It is passed to the SWBF2 bridge, which logs whether its own
; matches.
view_fov = CoDWaW.exe+0x3120348
; 1 = tell the SWBF2 bridge which of its buttons the player is holding: fire,
; aim and reload. What SWBF2 does with them is set on its side:
; [swbf2] forward_fire.
forward_buttons = 1
; Where this game records each of those as held: one byte, not zero while it
; is. The game keeps such a record for every action it has ("+attack",
; "+reload" ...) and switches it as the player's bindings say, so these work
; whatever the player has bound and on whatever device: keyboard, mouse or
; controller. Several places can be given with commas between; any one of them
; held counts. The ones below are +attack, +speed, and +reload with +usereload
; in the Steam 1.7 exe (docs/PHASE2.md says how they were found).
; Left empty, a button is read from the mouse or keyboard instead (left
; button, right button, R), which only suits a player who has it bound there.
held_fire = CoDWaW.exe+0x2C0FE5C
held_aim = CoDWaW.exe+0x2C0FDBC
held_reload = CoDWaW.exe+0x2C0FED4, CoDWaW.exe+0x2C0FEE8
; The same for the grenade button (+frag), which is the character's ability
; button: a grenade, a rocket or the Force, whichever is selected in SWBF2
; (docs/PHASE3.md). Left empty, the G key.
held_ability = CoDWaW.exe+0x2C0FE84
; And jump (+gostand): SWBF2's character jumps when it is pressed.
held_jump = CoDWaW.exe+0x2C0FDF8
; "The next ability" is nothing this game has an action for, so the bridge
; looks at a key and a controller button itself, while this game's window is
; the one in front. The key is a Windows virtual-key code (0x58 = X); the
; button is XInput's number for it (0x0100 = the left shoulder button, which
; is this game's own for a special grenade, of which this map has none;
; 0x0001, 0x0002, 0x0004, 0x0008 = up, down, left, right on the d-pad).
; 0 = none. Not left on the d-pad, though it was at first: that changes to
; what is fitted to the weapon in hand.
next_ability_key = 0x58
next_ability_pad = 0x0100
; And the same for that: "what is fitted to the weapon in hand", which is
; Boba Fett's flamethrower, part of his rifle. Pressed, it changes between
; the two. Left on the d-pad and the 5 key are this game's own for it; the
; game's own action is left with nothing to do, because while it has that to
; do the game shows the fitted weapon at the bottom of the screen, and the
; mod's scripts make the change when the bridge says the button is pressed.
fitted_key = 0x35
fitted_pad = 0x0004
; The byte behind this game's cg_drawGun setting (1 = draw the player's gun).
; While SWBF2's weapon is being drawn over the picture the bridge keeps it 0,
; so there is one gun on screen, and puts it back to 1 when SWBF2's picture
; stops. Left empty, the gun has to be hidden by hand: cg_drawGun 0 in the
; console.
draw_gun = CoDWaW.exe+0x3066528 > 0x10
; Where this game is drawing from: the camera's position (3 floats) and its
; axis (9: the directions it counts as forward, left and up). They sit just
; after view_fov. Sent to SWBF2, which in third person draws from the same
; place. In first person it is the player's eyes.
view_origin = CoDWaW.exe+0x3120354
view_axis = CoDWaW.exe+0x3120364
; Third person. While SWBF2 says it is showing the player's character from
; behind (and its picture is arriving), the bridge sets this game's
; cg_thirdPerson to 1 (third_person is the number behind that setting) and
; keeps the player's own soldier from being drawn, by setting in each of the
; hide_body places the bit the game's own hide() sets: the player entity's
; flags, and the flags in its client record. Both are undone when SWBF2 goes
; back to first person or goes away. docs/PHASE2.md says how they were found.
; How far behind the player the camera sits is this game's own
; cg_thirdPersonRange (120), which can be changed in its console.
third_person = CoDWaW.exe+0x2F9CC14 > 0x10
hide_body = CoDWaW.exe+0x136C6F8, CoDWaW.exe+0x136C870 > 0xCC
; Where the camera sits in third person. The game puts it straight behind the
; player's head, so whatever they aim at, and the crosshair, are behind the
; character's head. For a character with something to aim the camera is swung
; round the player by gun_view_angle degrees (third_person_angle is the number
; behind cg_thirdPersonAngle): negative puts the character left of the
; middle and the aim to its right. 0 leaves the game's own.
third_person_angle = CoDWaW.exe+0x328EBB0 > 0x10
gun_view_angle = -14
; A steady camera. In third person this game hangs its camera on the head of
; the player's own soldier (the bone "j_head"). The soldier is hidden, but it
; still breathes, shifts about and bobs as it runs, and the picture went with
; its head. head_call is the one call in the game's code that asks where that
; head is (a five-byte call to head_routine); the bridge sends it through a
; routine of its own that answers "straight above where the soldier stands,
; at eye height". head_entity_origin is where, in the entity handed to that
; call, its drawn position is. Leave head_call out to keep the game's own.
; Needs the game restarted to take effect.
head_call = CoDWaW.exe+0x5EDA5
head_routine = CoDWaW.exe+0x42F90
head_entity_origin = 0x24
; Shots, from behind the character. This game fires a player's shot the way
; their gun points, not the way they look: two angles (pitch, yaw) that it
; works out from the gun drawn in the player's hands, and stops working out
; in third person, where that gun is not drawn. Left alone, every shot from
; behind goes the way the player was facing when the view changed. gun_angles
; is where those two angles are kept; from behind, the bridge sets them every
; frame so that the shot lands on what the middle of the screen shows. For
; that it tells the scripts where the line through the middle of the screen
; runs, in aim_field (the player entity's "spawnflags", which the scripts read
; and which means nothing on a player), and they answer in scripts_say with
; how far along it the first thing is. docs/PHASE3.md has how this was found.
; The crosshair seen from behind is SWBF2's, in the middle of its picture.
; aim_mark = 1 also draws a small cross of the bridge's own on the spot the
; shot is pointed at, for checking that the two agree.
gun_angles = CoDWaW.exe+0x312B65C
aim_field = CoDWaW.exe+0x136C8A0
aim_mark = 0
; Being hit does not throw the view about from behind the character: the
; number behind bg_viewKickScale (how far the view is thrown for each point of
; damage) is kept at 0 while the view is third person, and put back afterwards.
view_kick = CoDWaW.exe+0x4F43C4 > 0x10
; How the bridge and the mod's scripts (waw/mod) talk: through two numbers on
; the player's entity that mean nothing on a player. kit_field is the one the
; scripts read as self.count, and the bridge writes: SWBF2's kit, the ability
; selected and each use of it. scripts_say is the one the scripts write as
; self.dmg: which weapon is in hand, whether the ability can be used, whether
; the weapon is empty, its magazine, and how far off the thing in the middle of
; the screen is. Both are fields of the first entity (docs/PHASE3.md).
kit_field = CoDWaW.exe+0x136C93C
scripts_say = CoDWaW.exe+0x136C8C4
; The knife, in first person: while the number at weapon_state (what the
; player's weapon is doing) is one of knife_states, this game's own arms and
; knife are shown and SWBF2's picture stands aside. [debug] log_weapon_state
; = 1 logs each change of that number, which is how the states were found: a
; knife attack goes 13, 14, 15 (a thrown grenade 16 to 21, a shot 5).
weapon_state = CoDWaW.exe+0x14ED170
knife_states = 13, 14, 15
; The same number says when the weapon is being reloaded (SWBF2's is then
; reloaded too) and when the player is sprinting (SWBF2's character sprints).
reload_states = 7, 8, 9, 10, 11
sprint_states = 23, 24
; Crouched: the player's flags, and which bit of them. SWBF2's character
; crouches while it is set.
stance = CoDWaW.exe+0x14ED134
crouch_bit = 0x4
; A jump is passed to SWBF2 only when it is one: pressed while the player is
; standing, upright, on something. (Pressed again in the air it does nothing
; in this game, and SWBF2's heroes would jump a second time off nothing.)
; ground is the number of the thing the player stands on, and ground_none
; what it reads in the air.
ground = CoDWaW.exe+0x14ED0F0
ground_none = 1023
; Jumps. SWBF2's characters jump higher than a WaW player, and so stay in the
; air longer; jump_height is the number behind this game's jump_height
; setting, and jump_heights what it is made for each kit (kit = units, ...),
; chosen so that the player is off the ground as long as the character is:
; troopers 75, heroes with guns 107, anyone with a lightsaber 150. The game's
; own 39 comes back when SWBF2 goes away.
jump_height = CoDWaW.exe+0x4F0BD8 > 0x10
jump_heights = 1 = 107, 2 = 75, 3 = 75, 4 = 107, 5 = 107, 6 = 107, 7 = 150, 8 = 150, 9 = 150, 10 = 150, 11 = 150, 12 = 150, 13 = 150
; More for the player to take: 200, so that a zombie's fourth blow is the one
; that puts them down (the game's own 100 makes it the second). max_health is
; the number behind the game's setting g_player_maxhealth, which it gives a
; player when it puts them into a map; the bridge keeps it at player_health.
; It has to be this setting and not the scripts' "maxhealth": that is another
; number, and the game gets a player back to this one after a blow. Leave
; either out for the game's own.
max_health = CoDWaW.exe+0x145581C > 0x10
player_health = 200
; The switches the game keeps on the player's entity, the lowest of which is
; what "god" typed into the console turns on and off. Only [debug]
; god_at_start uses it.
player_flags = CoDWaW.exe+0x136C8A4
; "Press F to ..." from behind the character. The game's routine that puts
; what the player can use on the screen gives up at once in third person
; (CoDWaW.exe+0x51130: "is the view from behind? then go to the end").
; hint_jump is that jump, two bytes (75 40), which the bridge takes out. Leave
; it out for the game's own behaviour: no hints from behind.
hint_jump = CoDWaW.exe+0x51137
; The scoreboard, played alone. The scores button (Tab, or Back on a
; controller) brings up "Mission Objectives" in a game played alone, of which
; zombies has none, and the co-op scoreboard only in an online game: two short
; jumps in the game's code on its "onlinegame" setting. Each entry here is one
; of them: where it is, the bytes that are there, and the bytes put in their
; place (the first never brings the objectives up; the second lets the
; scoreboard be drawn). Nothing is changed unless both are as expected. Leave
; it out for the game's own.
scoreboard_alone = CoDWaW.exe+0x379DA: 75 73 = EB 73, CoDWaW.exe+0x2680D2: 74 24 = 90 90
; The player's name on that scoreboard is the character's. SWBF2's side says
; who is being played, as a number (swbf2/arena/WAW_arena.lua, WHO: several
; characters share a kit); character_names has the name for each; and the
; bridge changes the player's name the way the player could, with "name ..."
; in the console, through console: the game's own routine for a line typed
; there. player_name is where the game has the name now (through the player's
; client record), read first so that it can be put back when SWBF2's picture
; stops. Leave console or character_names out and the player keeps their own.
console = CoDWaW.exe+0x194200
player_name = CoDWaW.exe+0x136C870 > 0x215C
character_names = 1 = Han Solo, 2 = Clone Trooper, 3 = Stormtrooper, 4 = Battle Droid, 5 = Boba Fett, 6 = Chewbacca, 7 = Princess Leia, 8 = Luke Skywalker, 9 = Obi-Wan Kenobi, 10 = Mace Windu, 11 = Darth Maul, 12 = Aayla Secura, 13 = Anakin Skywalker, 14 = Darth Vader, 15 = Yoda, 16 = Count Dooku, 17 = General Grievous, 18 = The Emperor
; Three of this game's own settings that the bridge switches, found by name.
; (Others above are reached through a pointer the game keeps to the setting,
; which never moves. None is known for these, and a plain address will not
; do: the game keeps its settings in one table, each where the last one left
; off, so one more "+set" when it is started moves every later setting along
; by one.) settings_table is roughly where that table is and
; settings_table_size how much of memory from there is looked through for a
; setting's name; the place found is in the log.
settings_table = CoDWaW.exe+0x1D80000
settings_table_size = 0x100000
; The crosshair. SWBF2's picture has that game's own in it for a character
; with something to aim, and this game's is switched off while it does. Leave
; crosshair_setting out to keep this game's on (there will then be two).
crosshair_setting = cg_drawCrosshair
; A lightsaber's ammunition. The weapon that stands for a lightsaber here has
; some, and this game shows it; for a character with a lightsaber that part
; of the HUD (the weapon's name and ammunition) is switched off.
ammo_setting = ammoCounterHide
; Footsteps. This game's player is heard walking and running whoever SWBF2's
; character is, and the Emperor (kit 13) glides. For the kits in quiet_kits
; this game's footsteps are switched off while the player is on their feet,
; and back on when they crouch (he creeps like anyone) and for anyone else.
footsteps_setting = cg_footsteps
quiet_kits = 13
; The byte behind this game's cl_paused: not zero while the pause menu is up.
; SWBF2's picture is drawn over everything, so while the game is paused it
; stands aside for the menu.
paused = CoDWaW.exe+0x1B552C4 > 0x10

[overlay]
; 1 = draw SWBF2's first-person weapon and HUD over this game's picture.
; Needs [overlay] publish = 1 on the SWBF2 side. Can be switched live.
draw = 0

[proxy]
; Optional: load another d3d9.dll (e.g. ReShade) instead of the system one.
chain =

[debug]
; 1 = log every change of the number at [waw] weapon_state.
log_weapon_state = 0
; 1 = the player begins each map unable to be hurt, exactly as if "god" had
; been typed into the console: it is the same switch ([waw] player_flags), so
; typing god there turns it off, and on again. For testing.
god_at_start = 0
